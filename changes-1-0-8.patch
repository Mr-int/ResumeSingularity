+    display: flex;
+    flex-wrap: wrap;
+    gap: 8px;
+}
+
+.catalog__btn {
+    min-height: 44px;
+    padding: 0 16px;
+    border-radius: 14px;
+    border: 1px solid transparent;
+    background: var(--catalog-blue);
+    color: #fff;
+    font: inherit;
+    cursor: pointer;
+}
+
+.catalog__btn:hover {
+    filter: brightness(1.08);
+}
+
+.catalog__btn:disabled {
+    opacity: 0.45;
+    cursor: not-allowed;
+}
+
+.catalog__btn--ghost {
+    background: transparent;
+    border-color: var(--catalog-line);
+    color: var(--catalog-text);
+}
+
+.catalog__btn--quiet {
+    background: transparent;
+    border-color: var(--catalog-magenta);
+    color: #ffd6f6;
+}
+
+.catalog__btn.is-on {
+    background: #fff;
+    color: #131313;
+}
+
+.catalog__form {
+    display: flex;
+    flex-direction: column;
+    gap: 14px;
+}
+
+.catalog__field {
+    display: flex;
+    flex-direction: column;
+    gap: 6px;
+}
+
+.catalog__field label {
+    color: var(--catalog-muted);
+    font-size: 13px;
+}
+
+.catalog__field input,
+.catalog__field textarea,
+.catalog__field select {
+    width: 100%;
+    padding: 12px 14px;
+    border-radius: 14px;
+    border: 1px solid var(--catalog-line);
+    background: #131313;
+    color: var(--catalog-text);
+    font: inherit;
+}
+
+.catalog__split {
+    display: grid;
+    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
+    gap: 12px;
+}
+
+.catalog__checks {
+    display: flex;
+    flex-wrap: wrap;
+    gap: 8px;
+    max-height: 180px;
+    overflow: auto;
+    padding: 8px;
+    border: 1px solid var(--catalog-line);
+    border-radius: 14px;
+}
+
+.catalog__checks label {
+    display: inline-flex;
+    align-items: center;
+    gap: 6px;
+    color: var(--catalog-text);
+    font-size: 14px;
+}
+
+.catalog__pager {
+    display: flex;
+    justify-content: space-between;
+    align-items: center;
+    gap: 12px;
+    margin-top: 18px;
+    color: var(--catalog-muted);
+}
+
+.catalog__response {
+    display: grid;
+    grid-template-columns: minmax(0, 1fr) auto auto;
+    gap: 10px 14px;
+    align-items: center;
+    padding: 12px 0;
+    border-top: 1px solid var(--catalog-line);
+}
+
+.catalog__response a {
+    color: var(--catalog-text);
+}
+
+@media (max-width: 720px) {
+    .catalog__main {
+        width: min(1120px, calc(100% - 28px));
+    }
+
+    .catalog__row,
+    .catalog__response {
+        grid-template-columns: 1fr;
+    }
+
+    .catalog__btn,
+    .catalog__pager .catalog__btn {
+        width: 100%;
+    }
+}
+
+@media (prefers-reduced-motion: reduce) {
+    .catalog__card,
+    .catalog__row,
+    .catalog__btn {
+        transition: none;
+    }
+}
diff --git a/src/pages/catalogFormat.js b/src/pages/catalogFormat.js
new file mode 100644
